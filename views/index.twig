{% extends "base.twig" %}

{% block content %}
	{# ========================================== #}
	{# THE ARCHITECTURAL PULSE: Hero Section     #}
	{# ========================================== #}
	<section class="relative w-full mb-8 mt-8 min-h-[500px] flex  overflow-hidden rounded-xl bg-white dark:bg-slate-900 shadow-sm">
		{% set main_hero = posts_turismo|length > 0 ? posts_turismo[0] : (hero_post ?: posts_nacionales[0]) %}
		
		<!-- Left Side: Content with Gradient Background -->
		<div class="relative z-20 w-full md:w-1/2 flex flex-col justify-center p-8 md:p-12 lg:p-20 bg-gradient-to-r from-white via-white/95 to-transparent dark:from-slate-900 dark:via-slate-900/95 ">
			<div class="max-w-md space-y-5">
				<h1 class="text-3xl md:text-4xl lg:text-5xl font-headline font-extrabold text-[#051139] dark:text-white leading-tight tracking-tight">
					{{ main_hero.title }}
				</h1>

				<p class="text-body-md text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed">
					{{ main_hero.excerpt|default(main_hero.content|striptags|truncate(150)) }}
				</p>

				<div class="pt-4">
					<a href="{{ main_hero.link }}" class="inline-flex items-center justify-center px-8 py-2.5 rounded-full bg-primary hover:bg-primary-dim text-white font-bold transition-all duration-300 shadow-md text-sm">
						Leer más
					</a>
				</div>
			</div>
		</div>

		<!-- Right Side: Post Image -->
		<div class="hidden md:block absolute right-0 top-0 bottom-0 w-3/5 z-10">
			<img src="{{ main_hero.thumbnail.src('large')|default(theme.link ~ '/assets/img/fallback-dn.png') }}" alt="{{ main_hero.title }}" class="object-cover w-full h-full object-center" />
			<!-- Soft transition overlay using custom CSS class -->
			<div class="absolute inset-y-0 -left-1 w-48 bg-gradient-to-r from-white via-white/80 to-transparent dark:from-slate-900 dark:via-slate-900/80"></div>
		</div>

		<!-- Mobile Background Image Overlay -->
		<div class="md:hidden absolute inset-0 z-0">
			<img src="{{ main_hero.thumbnail.src('large')|default(theme.link ~ '/assets/img/fallback-dn.png') }}" alt="{{ main_hero.title }}" class="object-cover w-full h-full opacity-20" />
		</div>
	</section>

	{# ========================================== #}
	{# THE PULSE CAROUSEL: Tonal Sectioning      #}
	{# ========================================== #}
	<section class="section-alt px-4 md:px-6 py-10 md:py-12 rounded-xl mb-8 overflow-hidden" x-data="{
		activeSlide: 0,
		slidesCount: 0,
		init() {
			this.slidesCount = this.$refs.slider.children.length;
		},
		next() {
			this.activeSlide = (this.activeSlide + 1) % this.slidesCount;
			this.scrollToActive();
		},
		prev() {
			this.activeSlide = (this.activeSlide - 1 + this.slidesCount) % this.slidesCount;
			this.scrollToActive();
		},
		scrollToActive() {
			const slider = this.$refs.slider;
			const cardWidth = slider.children[0].offsetWidth + (window.innerWidth < 768 ? 16 : 32); // width + gap
			slider.scrollTo({
				left: this.activeSlide * cardWidth,
				behavior: 'smooth'
			});
		}
	}">
		<div class="max-w-6xl mx-auto relative">
			<!-- Header & Controls -->
			<div class="flex items-center justify-between mb-8 px-1">
				<div class="flex flex-col gap-1">
					<h3 class="text-2xl md:text-4xl font-headline font-black text-on-surface dark:text-zinc-100 flex items-center gap-2 md:gap-3">
						{{ icon('journal-bookmark-fill', 'w-7 h-7 md:w-10 md:h-10 text-primary') }}
						Editorial
					</h3>
				</div>
				<div class="flex items-center gap-2 md:gap-3">
					<button @click="prev()" class="w-9 h-9 md:w-10 md:h-10 rounded-full border border-primary/20 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all">
						{{ icon('chevron-left', 'w-4 h-4 md:w-5 md:h-5') }}
					</button>
					<button @click="next()" class="w-9 h-9 md:w-10 md:h-10 rounded-full border border-primary/20 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-all">
						{{ icon('chevron-right', 'w-4 h-4 md:w-5 md:h-5') }}
					</button>
				</div>
			</div>

			<!-- Slider Track -->
			<div 
				x-ref="slider"
				class="flex gap-4 md:gap-8 overflow-x-auto snap-x snap-mandatory no-scrollbar pb-4"
				style="scroll-behavior: smooth;"
				@scroll.debounce.100ms="
					const slider = $refs.slider;
					const cardWidth = slider.children[0].offsetWidth + (window.innerWidth < 768 ? 16 : 32);
					activeSlide = Math.round(slider.scrollLeft / cardWidth);
				"
			>
				{% set all_pulse_posts = posts_nacionales|merge(posts_internacionales)|merge(posts_salud) %}
				{% for post in all_pulse_posts %}
					<div class="min-w-[85%] md:min-w-[45%] lg:min-w-[31%] snap-start">
						{% include "partials/card-pulse-modern.twig" with {post: post, loop: loop} %}
					</div>
				{% endfor %}
			</div>

			<!-- Pagination Dots -->
			<div class="flex justify-center items-center gap-2 mt-8">
				<template x-for="(i, index) in Array.from({ length: slidesCount })" :key="index">
					<button 
						@click="activeSlide = index; scrollToActive()"
						class="h-1.5 transition-all duration-300 rounded-full"
						:class="activeSlide === index ? 'w-8 bg-primary' : 'w-2 bg-primary/20 hover:bg-primary/40'"
						:aria-label="'Ir a nota ' + (index + 1)"
					></button>
				</template>
			</div>
		</div>
	</section>

	{# ========================================== #}
	{# SPORTS SECTION: High-Impact Mosaic Grid   #}
	{# ========================================== #}
	{% if posts_deportes|length > 0 %}
	<section class="mb-12 px-2 md:px-0">
		<div class="flex items-center justify-between mb-8 md:mb-10 px-1">
		<div class="flex flex-col gap-1">
			<h3 class="text-2xl md:text-4xl font-headline font-black text-on-surface dark:text-zinc-100 flex items-center gap-2 md:gap-3">					{{ icon('trophy-fill', 'w-7 h-7 md:w-10 md:h-10 text-primary') }}
					Deportes
				</h3>
			</div>
			<a href="{{ site.url }}/category/deportes" class="group flex items-center gap-2 text-[9px] md:text-[10px] font-black text-primary hover:text-[#051139] transition-all uppercase tracking-[0.2em]">
				Archivo
				{{ icon('arrow-right', 'w-3 h-3 md:w-4 md:h-4 group-hover:translate-x-1 transition-transform') }}
			</a>
		</div>
		
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 h-auto lg:h-[600px]">
			<!-- Featured Big Story -->
			<div class="lg:col-span-2 h-full">
				{% include "partials/card-sports-main.twig" with {post: posts_deportes[0]} %}
			</div>

			<!-- Secondary Column -->
			<div class="flex flex-col gap-8 h-full">
				{% if posts_deportes[1] %}
					<div class="flex-1">
						{% include "partials/card-sports-item.twig" with {post: posts_deportes[1]} %}
					</div>
				{% endif %}
				{% if posts_deportes[2] %}
					<div class="flex-1">
						{% include "partials/card-sports-item.twig" with {post: posts_deportes[2]} %}
					</div>
				{% endif %}
			</div>
		</div>
	</section>
	{% endif %}

	{# ========================================== #}
	{# DIARIO NACIONAL TV: YouTube Section       #}
	{# ========================================== #}
	<section class="section-alt px-6 py-12 rounded-xl mb-12 relative overflow-hidden group" x-data='{ 
		activeVideo: "{{ youtube_videos|first.id }}",
		activeTitle: "{{ youtube_videos|first.title|escape('js') }}",
		videos: {{ youtube_videos|json_encode()|raw }}
	}'>
		<!-- Decorative background elements -->
		<div class="absolute -left-32 -top-32 w-96 h-96 bg-tertiary/5 rounded-full blur-[100px] pointer-events-none"></div>
		<div class="absolute -right-32 -bottom-32 w-96 h-96 bg-primary/5 rounded-full blur-[100px] pointer-events-none transition-transform duration-1000 group-hover:scale-110"></div>

		<div class="max-w-6xl mx-auto relative z-10">
			<!-- Header -->
			<div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 pb-6 border-b border-outline-variant/10">
				<div class="space-y-2">
					<h3 class="text-3xl md:text-4xl font-headline font-extrabold text-on-surface dark:text-white flex items-center gap-3">
						{{ icon('youtube', 'w-8 h-8 text-tertiary') }}
						Últimos Videos
					</h3>
				</div>
				<div>
					<a href="https://www.youtube.com/@eldiarionacional2022?sub_confirmation=1" target="_blank" class="inline-flex items-center gap-3 px-8 py-3.5 rounded-full bg-primary hover:bg-primary-dim text-white font-bold transition-all duration-300 transform hover:scale-105 shadow-md shadow-primary/10 text-sm">
						{{ icon('play-btn-fill', 'w-5 h-5') }}
						Suscribirse al canal
					</a>
				</div>
			</div>

			<!-- Main Layout Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
				<!-- Featured Video Player (8 cols) -->
				<div class="lg:col-span-8 flex flex-col justify-between">
					<div class="aspect-video w-full rounded-3xl overflow-hidden shadow-2xl bg-black relative group/player">
						<iframe 
							x-show="activeVideo"
							class="w-full h-full relative z-10"
							:src="activeVideo ? 'https://www.youtube.com/embed/' + activeVideo + '?autoplay=0&rel=0' : ''" 
							title="YouTube video player" 
							frameborder="0" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen>
						</iframe>
						<!-- Loading placeholder / Poster -->
						<div class="absolute inset-0 flex items-center justify-center bg-slate-900">
							<div class="animate-spin rounded-full h-12 w-12 border-4 border-primary border-t-transparent"></div>
						</div>
					</div>
					<div class="mt-6 space-y-2">
						<span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-widest" x-text="videos.find(v => v.id === activeVideo)?.category || 'Especial'"></span>
						<h4 class="text-xl md:text-3xl font-headline font-extrabold text-on-surface dark:text-white leading-tight" x-text="activeTitle"></h4>
					</div>
				</div>

				<!-- Play List Column (4 cols) -->
				<div class="lg:col-span-4 flex flex-col space-y-4">
					<h5 class="text-[10px] font-bold uppercase tracking-[0.1em] text-on-surface/40 mb-2 px-1">Siguiente en la lista</h5>
					<div class="space-y-3 flex-1 overflow-y-auto max-h-[450px] pr-2 custom-scrollbar">
						<template x-for="(video, index) in videos" :key="video.id">
							<button 
								@click="activeVideo = video.id; activeTitle = video.title"
								class="w-full text-left group/item flex gap-4 p-3 rounded-[1.25rem] transition-all duration-500"
								:class="activeVideo === video.id ? 'bg-surface-container-lowest shadow-lg shadow-on-surface/5' : 'bg-transparent hover:bg-surface-container-highest/30'"
							>
								<!-- Thumbnail Preview -->
								<div class="relative w-24 aspect-video rounded-xl overflow-hidden flex-shrink-0 bg-slate-900 shadow-sm">
									<img :src="'https://img.youtube.com/vi/' + video.id + '/mqdefault.jpg'" class="w-full h-full object-cover transition-transform duration-700 group-hover/item:scale-110" alt="Thumbnail">
									<div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover/item:opacity-100 transition-opacity duration-300">
										<div class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center shadow-lg transform scale-75 group-hover/item:scale-100 transition-transform duration-300">
											{{ icon('play-fill', 'w-4 h-4') }}
										</div>
									</div>
								</div>

								<!-- Info -->
								<div class="flex flex-col justify-center py-0.5">
									<span class="text-[9px] font-bold uppercase tracking-widest text-tertiary mb-1.5" x-text="video.category"></span>
									<h6 class="text-xs font-bold text-on-surface dark:text-white line-clamp-2 leading-tight group-hover/item:text-primary transition-colors" x-text="video.title"></h6>
								</div>
							</button>
						</template>
					</div>
				</div>
			</div>
		</div>
	</section>

	{# ========================================== #}
	{# TRENDS & ENTERTAINMENT: Farándula + Tecnología #}
	{# ========================================== #}
	<section class="pb-8">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
			<!-- Farándula (8 cols) -->
			<div class="lg:col-span-8">
				<div class="bg-surface-container-low p-8 md:p-12 rounded-xl relative overflow-hidden group h-full flex items-center">
					<div class="relative z-10 flex flex-col md:flex-row items-center gap-12 w-full">
						<div class="flex-1 space-y-6 text-center md:text-left">
							<span class="px-4 py-1.5 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-widest">Farándula</span>
							<h3 class="text-4xl md:text-5xl font-headline font-extrabold leading-tight">El mundo del <br> espectáculo</h3>
						</div>
						<div class="grid grid-cols-2 gap-4 flex-1">
							{% set fallback_img = theme.link ~ '/assets/img/fallback-dn.png' %}
							{% for post in posts_farandula|slice(0, 2) %}
								<a href="{{ post.link }}" class="block group/item">
									<div class="aspect-[3/4] rounded-2xl overflow-hidden mb-3 shadow-lg">
										<img src="{{ post.thumbnail.src('large')|default(post.thumbnail.src)|default(fallback_img) }}" class="w-full h-full object-cover transition-transform duration-700 group-hover/item:scale-110">
									</div>
									<h4 class="text-sm font-bold leading-tight line-clamp-2 group-hover/item:text-primary transition-colors">{{ post.title }}</h4>
								</a>
							{% endfor %}
						</div>
					</div>
					<!-- Decorative background element -->
					<div class="absolute -right-20 -bottom-20 w-64 h-64 bg-primary/5 rounded-full blur-3xl group-hover:bg-primary/10 transition-colors"></div>
				</div>
			</div>

			<!-- Tecnología (4 cols) -->
			<div class="lg:col-span-4 py-6 h-full">
				<h3 class="text-2xl font-headline font-extrabold mb-10 flex items-center gap-3">
					<span class="w-2 h-8 bg-tertiary rounded-full"></span>
					Tecnología
				</h3>
				<div class="space-y-10">
					{% for post in posts_tecnologia|slice(0, 2) %}
						<article class="group flex gap-6 items-start">
							<span class="text-4xl font-headline font-extrabold text-surface-container-highest group-hover:text-tertiary/30 transition-colors leading-none">0{{ loop.index }}</span>
							<div class="space-y-1">
								<span class="text-[10px] font-bold uppercase tracking-widest text-tertiary/60">{{ post.terms('category')|first.name|default('Tecnología') }}</span>
								<h4 class="text-md font-bold leading-tight group-hover:text-primary transition-colors">
									<a href="{{ post.link }}">{{ post.title }}</a>
								</h4>
							</div>
						</article>
					{% endfor %}
				</div>
			</div>
		</div>
	</section>

	{# ========================================== #}
	{# SECONDARY PULSE: Analysis                 #}
	{# ========================================== #}
	<section class="pb-8">
		<div class="max-w-4xl mx-auto">
			{% if latest_analisis %}
				<div class="flex flex-col items-center text-center mb-12">
					<span class="px-4 py-1 rounded-full bg-primary/10 text-primary text-[10px] font-bold uppercase tracking-widest mb-4">Opinión y Análisis</span>
					<h3 class="text-3xl font-headline font-extrabold italic">"La profundidad de la noticia"</h3>
				</div>
				{% include "partials/card-pulse-modern.twig" with {post: latest_analisis} %}
			{% endif %}
		</div>
	</section>

{% endblock %}
