<article class="relative h-full rounded-2xl overflow-hidden group shadow-xl bg-white dark:bg-slate-900 border border-black/5 dark:border-white/5 flex flex-col">
    <!-- Image Section -->
    <div class="relative h-48 overflow-hidden">
        {% if post.thumbnail and post.thumbnail.src %}
            <img src="{{ post.thumbnail.src('medium')|default(post.thumbnail.src) }}" 
                 alt="{{ post.title }}" 
                 class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
        {% else %}
            <div class="w-full h-full bg-[#051139]/5"></div>
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
        
        <!-- Category Overlay -->
        <div class="absolute top-4 left-4">
            <span class="px-3 py-1 bg-white/90 dark:bg-[#051139]/90 backdrop-blur-md text-[#051139] dark:text-white rounded-lg text-[9px] font-black uppercase tracking-widest border border-white/20">
                Resumen
            </span>
        </div>
    </div>

    <!-- Content Section -->
    <div class="p-6 flex-1 flex flex-col">
        <div class="flex items-center gap-2 mb-3">
             <span class="text-[9px] font-bold text-primary uppercase tracking-widest">{{ post.post_date|date('d M, Y') }}</span>
        </div>
        
        <h3 class="text-lg font-headline font-extrabold text-[#051139] dark:text-white leading-tight group-hover:text-primary transition-colors line-clamp-3">
            <a href="{{ post.link }}" class="after:absolute after:inset-0">
                {{ post.title }}
            </a>
        </h3>

        <div class="mt-auto pt-4 flex items-center justify-between text-primary font-black text-[9px] uppercase tracking-[0.2em] opacity-0 group-hover:opacity-100 transition-all transform translate-y-2 group-hover:translate-y-0">
            Leer noticia
            {{ icon('chevron-right', 'w-3 h-3') }}
        </div>
    </div>
</article>