<article class="relative h-[480px] rounded-xl overflow-hidden group shadow-2xl bg-[#051139]">
    <!-- Background Image with Zoom Effect -->
    <div class="absolute inset-0 z-0">
        {% if post.thumbnail and post.thumbnail.src %}
            <img src="{{ post.thumbnail.src('large')|default(post.thumbnail.src) }}" 
                 alt="{{ post.title }}" 
                 class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110 opacity-60 group-hover:opacity-80">
        {% else %}
            <div class="w-full h-full bg-gradient-to-br from-[#051139] to-primary"></div>
        {% endif %}
        <!-- Intense Brand Overlay (Blue) -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#051139] via-[#051139]/40 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-primary/20 to-transparent opacity-0 group-hover:opacity-40 transition-opacity duration-700"></div>
    </div>

    <!-- Top Badge: Brand Consistent -->
    <div class="absolute top-6 left-6 z-20">
        <div class="flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg font-headline font-black text-[10px] uppercase tracking-[0.2em] shadow-lg shadow-primary/30">
            {{ icon('trophy-fill', 'w-3.5 h-3.5') }}
            <span>Deportes DN</span>
        </div>
    </div>

    <!-- Content Area -->
    <div class="absolute inset-x-0 bottom-0 p-8 z-20 flex flex-col justify-end h-full">
        <!-- Metadata -->
        <div class="flex items-center gap-3 mb-4">
            <span class="text-white/60 text-[10px] font-bold uppercase tracking-widest">{{ post.post_date|date('d M, Y') }}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        </div>

        <!-- Title: Bold and Serious -->
        <h3 class="text-2xl md:text-3xl font-headline font-extrabold text-white leading-[1.1] tracking-tight group-hover:text-blue-300 transition-colors duration-300 mb-6">
            <a href="{{ post.link }}" class="after:absolute after:inset-0">
                {{ post.title }}
            </a>
        </h3>

        <!-- Action Bar -->
        <div class="flex items-center justify-between mt-2 pt-6 border-t border-white/10">
            <div class="flex items-center gap-3 text-white font-bold text-xs uppercase tracking-[0.15em]">
                Ver crónica
                <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-primary transition-all duration-300">
                    {{ icon('arrow-right', 'w-4 h-4') }}
                </div>
            </div>
            
            <div class="text-[9px] font-black text-white/20 uppercase tracking-widest group-hover:text-white/40 transition-colors">
                Periodismo Deportivo
            </div>
        </div>
    </div>

    <!-- Decorative Border Glow -->
    <div class="absolute inset-0 border-2 border-primary/0 group-hover:border-primary/30 rounded-xl transition-all duration-500 pointer-events-none"></div>
</article>