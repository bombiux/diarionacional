<div x-show="mobileMenuOpen" 
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="-translate-x-full"
     x-transition:enter-end="translate-x-0"
     x-transition:leave="transition ease-in duration-300"
     x-transition:leave-start="translate-x-0"
     x-transition:leave-end="-translate-x-full"
     class="fixed top-[72px] inset-x-0 bottom-0 z-[60] md:hidden" 
     x-cloak>
    
    <!-- Backdrop -->
    <div @click="mobileMenuOpen = false" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm focus:outline-none focus:ring-0"></div>

    <!-- Menu Content -->
    <div class="relative h-full w-80 flex flex-col p-6 pt-4 bg-slate-50 dark:bg-slate-950 rounded-br-2xl shadow-2xl overflow-y-auto focus:outline-none focus:ring-0">
        <div class="mb-8 flex justify-between items-start">
            <div class="flex flex-col gap-2">
                <a href="{{ site.url }}" class="focus:outline-none focus:ring-0">
                    <img src="{{ theme.link }}/assets/img/logo-dn.png" alt="Diario Nacional" class="h-10 w-auto object-contain">
                </a>
            </div>
            <button @click="mobileMenuOpen = false" class="text-slate-400 hover:text-primary transition-colors focus:outline-none focus:ring-0">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <nav class="flex flex-col gap-2 font-headline font-bold">
            {% set menu_items = (menu ? menu.get_items : null) ?: categories_menu %}
            {% for item in menu_items %}
                <a class="flex items-center gap-4 px-4 py-3 transition-all rounded-xl {{ item.current ? 'bg-blue-100 dark:bg-blue-900/30 text-primary dark:text-blue-200' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800' }}" 
                   href="{{ item.link }}">
                    {% if item.icon %}
                        <span class="material-symbols-outlined">{{ item.icon }}</span>
                    {% else %}
                        {# Fallback icons based on title if no icon is set #}
                        {% set icon_name = 'article' %}
                        {% if 'nacional' in item.title|lower %}{% set icon_name = 'public' %}
                        {% elseif 'internacional' in item.title|lower %}{% set icon_name = 'language' %}
                        {% elseif 'ambiente' in item.title|lower %}{% set icon_name = 'eco' %}
                        {% elseif 'deporte' in item.title|lower %}{% set icon_name = 'sports_soccer' %}
                        {% elseif 'salud' in item.title|lower %}{% set icon_name = 'medical_services' %}
                        {% elseif 'viral' in item.title|lower %}{% set icon_name = 'bolt' %}
                        {% elseif 'tecnolog' in item.title|lower %}{% set icon_name = 'biotech' %}
                        {% elseif 'farandula' in item.title|lower %}{% set icon_name = 'theater_comedy' %}
                        {% endif %}
                        <span class="material-symbols-outlined">{{ icon_name }}</span>
                    {% endif %}
                    {{ item.title }}
                </a>
            {% endfor %}
            
            {# Fallback manually if they are not in the dynamic menu #}
            {% set titles = menu_items|map(i => i.title|lower) %}
            {% if 'ambiente' not in titles %}
                <a class="flex items-center gap-4 px-4 py-3 transition-all rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800" href="{{ site.url }}/category/ambiente">
                    <span class="material-symbols-outlined">eco</span>
                    Ambiente
                </a>
            {% endif %}
            {% if 'salud' not in titles %}
                <a class="flex items-center gap-4 px-4 py-3 transition-all rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800" href="{{ site.url }}/category/salud">
                    <span class="material-symbols-outlined">medical_services</span>
                    Salud
                </a>
            {% endif %}
        </nav>

        <div class="mt-auto pt-8 flex items-center gap-4 border-t border-slate-200 dark:border-slate-800">
            <a aria-label="Facebook" class="text-on-surface-variant hover:text-primary transition-colors duration-200" href="https://www.facebook.com/diarionacional" target="_blank" rel="noopener">
                <svg class="w-6 h-6 fill-current" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"></path>
                </svg>
            </a>
            <a aria-label="TikTok" class="text-on-surface-variant hover:text-primary transition-colors duration-200" href="#" target="_blank" rel="noopener">
                <svg class="w-6 h-6 fill-current" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12.525.02c1.31-.02 2.61.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.9-.32-1.89-.23-2.74.24-.81.47-1.4 1.31-1.54 2.22-.16.94.13 1.95.74 2.67.61.73 1.55 1.12 2.49 1.13 1.13.04 2.21-.6 2.78-1.58.26-.45.41-.95.42-1.47V.02z"></path>
                </svg>
            </a>
            <a aria-label="X" class="text-on-surface-variant hover:text-primary transition-colors duration-200" href="https://x.com/diarionacional" target="_blank" rel="noopener">
                <svg class="w-5 h-5 fill-current" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
            </a>
        </div>
    </div>
</div>