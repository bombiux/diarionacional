<article class="relative h-full min-h-[400px] lg:min-h-full rounded-2xl overflow-hidden group shadow-2xl bg-[#051139]">
    <!-- Background Image with Parallax-like Zoom -->
    <div class="absolute inset-0 z-0">
        {% if post.thumbnail and post.thumbnail.src %}
            <img src="{{ post.thumbnail.src('large')|default(post.thumbnail.src) }}" 
                 alt="{{ post.title }}" 
                 class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105 opacity-50 group-hover:opacity-70">
        {% endif %}
        <!-- Deep Brand Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#051139] via-[#051139]/40 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-primary/10 to-transparent"></div>
    </div>

    <!-- Live Indicator Badge -->
    <div class="absolute top-8 left-8 z-20 flex items-center gap-3">
        <div class="flex items-center gap-2 px-5 py-2 bg-primary text-white rounded-full font-headline font-black text-[11px] uppercase tracking-[0.25em] shadow-xl shadow-primary/40">
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            Crónica Estelar
        </div>
    </div>

    <!-- Content: Immersive & Large -->
    <div class="absolute inset-0 p-6 md:p-8 lg:p-12 z-20 flex flex-col justify-end h-full">
        <div class="max-w-2xl">
            <!-- Title with High Impact -->
            <h3 class="text-2xl md:text-4xl lg:text-5xl font-headline font-black text-white leading-[1.1] md:leading-[1] tracking-tighter group-hover:text-blue-300 transition-colors duration-500 mb-4 md:mb-6 uppercase italic">
                <a href="{{ post.link }}" class="after:absolute after:inset-0">
                    {{ post.title }}
                </a>
            </h3>

            <!-- Dynamic Excerpt -->
            <p class="text-white/60 text-sm md:text-base leading-relaxed line-clamp-2 mb-8 font-sans max-w-xl group-hover:text-white/80 transition-colors">
                {{ post.excerpt|default(post.content|striptags|truncate(150)) }}
            </p>

            <!-- Action Bar -->
            <div class="flex items-center gap-6">
                <div class="inline-flex items-center gap-4 text-white font-black text-[10px] uppercase tracking-[0.3em]">
                    Ver cobertura completa
                    <div class="w-12 h-12 rounded-full bg-white text-[#051139] flex items-center justify-center group-hover:bg-primary group-hover:text-white transition-all duration-500 transform group-hover:scale-110 shadow-2xl">
                        {{ icon('arrow-right', 'w-6 h-6') }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- High-Impact Glass Border -->
    <div class="absolute inset-0 border-[8px] border-white/5 rounded-2xl pointer-events-none group-hover:border-primary/20 transition-all duration-500"></div>
</article>